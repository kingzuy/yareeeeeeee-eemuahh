#include <iostream>
#include <string>
#include <vector>
#include <cstring>
#include <fstream>
#include <filesystem>

#include <openssl/aes.h>
#include <openssl/evp.h>

namespace fs = std::filesystem;

std::string aes_encrypt(const std::string& plaintext, const std::string& key_str, const std::string& iv_str) {
    EVP_CIPHER_CTX* ctx = EVP_CIPHER_CTX_new();
    std::string ciphertext;

    unsigned char key[16] = {0};
    unsigned char iv[16] = {0};
    
    // Ambil 16 byte pertama
    memcpy(key, key_str.c_str(), std::min(key_str.length(), (size_t)16));
    memcpy(iv, iv_str.c_str(), std::min(iv_str.length(), (size_t)16));

    if (ctx) {
        if (EVP_EncryptInit_ex(ctx, EVP_aes_128_cbc(), NULL, key, iv) == 1) {
            std::vector<unsigned char> out(plaintext.size() + AES_BLOCK_SIZE);
            int len, ciphertext_len;

            if (EVP_EncryptUpdate(ctx, out.data(), &len, (const unsigned char*)plaintext.c_str(), plaintext.size()) == 1) {
                ciphertext_len = len;
                if (EVP_EncryptFinal_ex(ctx, out.data() + len, &len) == 1) {
                    ciphertext_len += len;
                    ciphertext.assign(out.begin(), out.begin() + ciphertext_len);
                }
            }
        }
        EVP_CIPHER_CTX_free(ctx);
    }
    return ciphertext;
}

int main(int argc, char* argv[]) {
    if (argc != 4) {
        std::cout << "Usage: " << argv[0] << " <filename> <key> <iv>" << std::endl;
        return 1;
    }

    std::string filename = argv[1];
    std::string key = argv[2];
    std::string iv = argv[3];

    std::ifstream file(filename, std::ios::binary | std::ios::ate);
    if (!file) {
        std::cerr << "Error: File not found!" << std::endl;
        return 1;
    }

    std::streamsize size = file.tellg();
    file.seekg(0, std::ios::beg);
    std::string buffer(size, '\0');
    
    if (!file.read(&buffer[0], size)) {
        std::cerr << "Error reading file!" << std::endl;
        return 1;
    }
    file.close();

    std::cout << "Encrypting " << filename << "..." << std::endl;
    std::string encrypted = aes_encrypt(buffer, key, iv);

    std::string out_filename = filename + ".enc";
    std::ofstream out_file(out_filename, std::ios::binary);
    out_file.write(encrypted.c_str(), encrypted.size());
    out_file.close();

    // Hapus asli
    fs::remove(filename);

    std::cout << "Done. Original file deleted." << std::endl;
    return 0;
}
